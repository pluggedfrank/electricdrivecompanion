// Kopie dieser Datei als Secrets.xcconfig anlegen und den eigenen Key eintragen.
// Secrets.xcconfig steht in .gitignore und wird nicht eingecheckt.
//
// Key anlegen: https://developer.tomtom.com/ -> Dashboard -> API Keys
// Der Freemium-Key deckt Maps, Search und Routing ab.

TOMTOM_API_KEY = YOUR_API_KEY

