<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Die Pflichtangaben eines Bundles. Ohne CFBundleIdentifier laesst sich
	     die App uebersetzen, aber nicht installieren; der Simulator antwortet
	     dann mit "Missing Bundle ID". Die Werte kommen aus den
	     Build-Einstellungen, damit project.yml die einzige Quelle bleibt. -->
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>de</string>
	<key>CFBundleDisplayName</key>
	<string>LadeRoute</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Leeres Woerterbuch heisst: Standard-Startbildschirm. Vorher stand hier
	     ein UIColorName ohne Wert, was keine Farbe benennt. -->
	<key>UILaunchScreen</key>
	<dict/>
	<!-- Hoch- und Querformat. Die Fahransicht hat fuer das Querformat eine
	     eigene Aufteilung (Kacheln rechts ueber die volle Hoehe, Fahrleiste
	     nur unter der Karte); bis zum 30.09.2026 stand hier nur Hochformat,
	     und das iPhone drehte nicht. Kopfueber bleibt aus, wie bei Apple Karten. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Der Startpunkt der Route und die Suche nach Ladestationen in der Nähe brauchen deinen Standort.</string>
	<!-- Ansagen und Ortung laufen während der Fahrt weiter, auch bei
	     gesperrtem Bildschirm oder wenn Musik vorne ist. Die Ortung im
	     Hintergrund braucht keine Freigabe "Immer": Sie startet im
	     Vordergrund, und iOS zeigt dann oben die blaue Anzeige. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>location</string>
	</array>
	<key>TomTomAPIKey</key>
	<string>$(TOMTOM_API_KEY)</string>
</dict>
</plist>
